@using GestionPersonnel.Models.Salaires
@inject UserSessionStateService UserSession
@if (display)
{
    <EditForm Model="@SalaireDetail" OnValidSubmit="@(() => ADDAvanceorDatte(SalaireDetail))">
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content shadow">

                    <!-- Header -->
                    <div class="modal-header bg-light">
                        <h5 class="modal-title"><strong>Ajouter une Transaction</strong></h5>
                        <button type="button" class="btn-close" @onclick="Hide"></button>
                    </div>

                    <!-- Info de l'employé -->
                    <div class="px-4 pt-3">
                        <div class="d-flex align-items-center border rounded p-3 mb-3" style="background-color: #f5f7fa;">
                            <div class="me-3">
                                <i class="bi bi-person-circle fs-2 text-primary"></i>
                            </div>
                            <div>
                                <strong>@SalaireDetail.NomEmploye @SalaireDetail.PrenomEmploye</strong><br />
                                <span class="text-muted">@SalaireDetail.NomFonction</span><br />
                                <span class="text-success fw-bold">$ @SalaireDetail.Salaire DA</span>
                            </div>
                        </div>
                    </div>

                    <!-- Corps -->
                    <div class="modal-body">

                        <!-- Type de transaction -->
                        <div class="mb-3">
                            <label class="form-label">Type de transaction</label> <br />
                            <InputRadioGroup @bind-Value="@type" class="d-flex flex-wrap gap-2">

                                <div style="display:flex;margin-bottom: 1rem;gap: 10px;">
                                    <label class="form-check form-check-inline input-box">
                                        <InputRadio class="form-check-input" Value="1" />
                                        <span class="form-check-label">Avance</span>
                                    </label>

                                 
                                    <label class="form-check form-check-inline input-box">
                                        <InputRadio class="form-check-input" Value="4" />
                                        <span class="form-check-label">Prime</span>
                                    </label>
                                </div>

                                <div style="display:flex;gap: 10px;">
                                    <label class="form-check form-check-inline input-box">
                                        <InputRadio class="form-check-input" Value="2" />
                                        <span class="form-check-label">Dette</span>
                                    </label>
                                    <label class="form-check form-check-inline input-box">
                                        <InputRadio class="form-check-input" Value="3" />
                                        <span class="form-check-label">Remboursement</span>
                                    </label>

                                    
                                </div>

                            </InputRadioGroup>
                        </div>

                        <!-- Montant -->
                        <div class="mb-3">
                            <label class="form-label">Montant (DA)</label>
                            <InputNumber @bind-Value="SalaireDetail.amount" class="form-control" placeholder="0.00" min="500" />
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="form-label">Description (optionnel)</label>
                            <InputTextArea class="form-control" @bind-Value="SalaireDetail.Description"
                                           placeholder="Ajouter une note ou description..." rows="2"
                                           style="resize: none;" />
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">
                        <button type="button" class="btn-c" @onclick="Hide">Annuler</button>
                        <button type="submit" class="@GetButtonClass()">@GetButtonText()</button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

<style>
    .input-box {
        height: 35px;
        display: flex;
        border: 1px solid #a49d9d;
        border-radius: 5px;
        width: 100%;
        padding: 0 10px;
        cursor: pointer;
        gap: 6px;
        align-items: center;
        transition: background-color 0.2s ease;
    }

        .input-box:hover {
            background-color: #f0f0f0;
        }

    .form-check {
        padding-left: 0.7rem !important;
    }

    .form-check-input[type=radio] {
        margin: auto 0;
    }

    .form-check-label {
        margin: auto 0;
    }

    .valid.modified:not([type=checkbox]) {
        outline: 1px solid black;
    }

    .form-check-input:checked {
        background-color: black;
        border-color: black;
    }

        .form-check-input:checked[type=radio] {
            background-image: none !important;
        }
</style>
