                                                <td>@remboursement.Date.ToString("yyyy-MM-dd")</td>
                                                <td>@remboursement.Montant</td>
                                                <td>@remboursement.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td><strong>Total</strong></td>
                                            <td><strong>@totalDette</strong></td>
                                            <td><strong></strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>


