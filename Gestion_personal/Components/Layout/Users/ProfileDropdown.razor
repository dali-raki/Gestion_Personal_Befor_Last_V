@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject UserSessionStateService UserSessionStateService
@implements IDisposable
@rendermode InteractiveServer

<div id="profileDropdown" class="profile-dropdown">
    <div class="profile-icon" @onclick="ShowList" @onclick:stopPropagation>
        <img src="Images/default-employee.png" alt="Profile Photo" class="profile-photo"/>
    </div>
    @if (isOpenList)
    {
    <div id="dropdownMenu" class="dropdown-menu">
        <div class="menu-item">
            <img src="Images/user.png" width="16" height="16" class="icon"/>
            <span>@UserSessionStateService.session.UserName</span>
        </div>
        <div class="menu-item logout-item" @onclick="Logout">
            <img src="Images/exit.png" width="16" height="16" class="icon"/>
            <button class="btn hover">Logout</button>
        </div>
    </div>
    }
</div>

@code {
private bool isOpenList = false;
private DotNetObjectReference<ProfileDropdown>? dotNetRef;

private async Task ShowList()
{
isOpenList = !isOpenList;

if (isOpenList)
{
dotNetRef = DotNetObjectReference.Create(this);
await JSRuntime.InvokeVoidAsync("initializeClickOutsideHandler", dotNetRef, "profileDropdown");
}
}

[JSInvokable]
public void HandleOutsideClick()
{
isOpenList = false;
StateHasChanged();
}

private void Logout()
{
UserSessionStateService.ClearUserSession();
NavigationManager.NavigateTo("/");
}

public void Dispose()
{
dotNetRef?.Dispose();
}
}

<script>
    window.initializeClickOutsideHandler = (dotNetObjRef, elementId) => {
        const element = document.getElementById(elementId);

        if (!element) {
            console.error(`Element with ID '${elementId}' not found.`);
            return;
        }

        const outsideClickHandler = (event) => {
            if (!element.contains(event.target)) {
                dotNetObjRef.invokeMethodAsync("HandleOutsideClick");
                document.removeEventListener("click", outsideClickHandler);
            }
        };

        document.addEventListener("click", outsideClickHandler);
    };
</script>

<style>
    /* Profile Dropdown Container */
    .profile-dropdown {
        position: relative;
        display: inline-block;
    }

    /* Profile Icon Section */
    .profile-icon {
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .profile-photo {
        width: 40px;
        height: 40px;
        border-radius: 50%; /* Makes the image circular */
        border: 2px solid #ddd; /* Optional: Adds a border */
        object-fit: cover; /* Ensures the image fits well in the circle */
    }

    /* Dropdown Menu */
    .dropdown-menu {
        position: absolute;
        top: 100%;
        right: 0;
        background-color: white;
        border: 1px solid #ddd;
        border-radius: 8px; /* Rounded corners */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        padding: 10px;
        width: 180px; /* Fixed width for better alignment */
        display: none; /* Initially hidden */
    }

    .dropdown-menu.show {
        display: block; /* Show dropdown when active */
    }

    /* Menu Items */
    .menu-item {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        gap: 10px; /* Space between icon and text */
        cursor: pointer;
        transition: background-color 0.2s ease; /* Smooth hover effect */
    }

    .menu-item:hover {
        background-color: #f5f5f5; /* Light gray background on hover */
        border-radius: 4px; /* Rounded corners for hover effect */
    }

    /* Logout Item Specific Styles */
    .logout-item {
        margin-top: 8px; /* Add space between user info and logout */
        padding-top: 8px;
        border-top: 1px solid #eee; /* Separator line */
    }

    .logout-item .btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        font-size: 14px;
        color: #333; /* Default text color */
        transition: color 0.2s ease; /* Smooth color transition */
    }

    .logout-item .btn:hover {
        color: #888; /* Gray color on hover */
        cursor: pointer; /* Change cursor to pointer */
    }

    /* Icons */
    .icon {
        width: 16px;
        height: 16px;
        object-fit: contain; /* Ensure icons are properly scaled */
    }
</style>