@using Implementation.Services.Logs
@using Infrastructures.Domains.Models.Logs
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@inject UserSessionStateService UserSession
@inject HttpClient Http
@inject NavigationManager Nav


<div>
    <p>@UserSession.Role + @UserSession.Name</p>
    <button @onclick="Logout" @onclick:preventDefault>خروج</button>
</div>
@code {
    [Inject] private ILogsActionService logsActionService { get; set; }
    private async Task Logout()
    {
        var log = new LogActions
        {
            ActionType = ActionType.Logout,
            ActionDate = DateTime.Now,
            Description = $"Déconnexion en tant que {UserSession.Name}",

        };
        await logsActionService.settLog(log);
        await Http.PostAsync("api/auth/logout", null);
        UserSession.ClearUser();
        Nav.NavigateTo("/");
    }
}
