@rendermode InteractiveServer
@inject UserSessionStateService UserSession

@if (IsVisiblUpdateEquipe)
{
    <div class="modal" tabindex="-1" style="display: block;">
        <div class="modal-dialog w-50">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Mise à jour équipe</h5>
                </div>

                <div class="modal-body">
                    <EditForm Model="this" OnSubmit="UpdateEquipe">
                        <div class="form-group">
                            <label>Choisir l'équipe</label>
                            <RadzenDropDown @bind-Value="selectedEquipeId"
                                            Data="@equipes"
                                            TextProperty="NomEquipe"
                                            ValueProperty="EquipeID"
                                            Style="width: 100%;"
                                            Placeholder="-- Choisir l'équipe --"
                                            AllowClear="true"
                                            AllowFiltering="true"
                                            Change="OnEquipeChange" />
                        </div>

                        <div class="form-group">
                            <label>Modifier le nom d'équipe</label>
                            <input type="text" class="form-control" placeholder="Nom d'équipe" @bind="selectedEquipeName" />
                        </div>

                        <div class="form-group">
                            <label>Modifier le chef d'équipe</label>
                            <RadzenDropDown @bind-Value="selectedChefId"
                                            Data="@employes"
                                            ValueProperty="EmployeID"
                                            Style="width: 100%;"
                                            Placeholder="-- Choisir le chef --"
                                            AllowClear="true"
                                            AllowFiltering="true">
                                <Template Context="emp">
                                    @($"{emp.Nom} {emp.Prenom}")
                                </Template>
                            </RadzenDropDown>
                        </div>

                        <div class="form-group">
                            <label>Choisir les membres de l'équipe</label>
                            <input type="text" class="form-control mb-2" placeholder="Nom ou prénom"
                                   @bind="searchTerm" @bind:event="oninput" />
                        </div>

                        <div class="form-group">
            
                            <div class="checkbox-group scrollable border rounded p-2" style="height: 120px;">
                                @if (FilteredEmployees.Any())
                                {
                                    @foreach (var employe in FilteredEmployees)
                                    {
                                        <label class="checkbox-item d-block">
                                            <input type="checkbox"
                                                   checked="@selectedMemberIds.Contains(employe.EmployeID)"
                                                   @onchange="e => OnMemberCheckboxChange(e, employe.EmployeID)" />
                                            @employe.Nom @employe.Prenom
                                        </label>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Aucun employé disponible</p>
                                }
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-c" @onclick="Hide_popup_UpdateEquipe">Annuler</button>
                            <button type="submit" class="btn-p">Mettre à jour</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <style>
        .scrollable {
            overflow-y: auto;
            max-height: 150px;
        }

        .checkbox-item {
            margin-bottom: 6px;
        }
    </style>
}

@using GestionPersonnel.Models.EmplyeeEquipe
@using GestionPersonnel.Services
@using Implementation.Services.Logs
@using Infrastructures.Domains.Models.Logs
@using global::Services.Interfaces

@using Equipe = GestionPersonnel.Models.Equipe.Equipe
@using Employe = GestionPersonnel.Models.Employe.Employe
@inject IEmployeService EmployeService
@inject IEmployeeEquipeService EmployeeEquipeService
@inject IEquipeService EquipeService

@code {
    [Parameter] public bool IsVisiblUpdateEquipe { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }
    [Inject] private ILogsActionService logsActionService { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }
    private List<Employe> employes = new();
    private List<Employe> allEmployees = new();
    private List<Equipe> equipes = new();
    private List<int> selectedMemberIds = new();
    private string selectedEquipeName;
    private int? selectedChefId;
    private int? selectedEquipeId;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        employes = await EmployeService.GetEmployeesAsync();
        equipes = await EquipeService.GetAllEquipesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisiblUpdateEquipe)
        {
            employes = await EmployeService.GetEmployeesAsync();
            equipes = await EquipeService.GetAllEquipesAsync();
        }
    }

    private async Task OnEquipeChange(object value)
    {
        selectedEquipeId = value as int?;

        if (selectedEquipeId.HasValue)
        {
            var selectedEquipe = await EquipeService.GetEquipeByIdAsync(selectedEquipeId.Value);

            if (selectedEquipe != null)
            {
                selectedEquipeName = selectedEquipe.NomEquipe;
                selectedChefId = selectedEquipe.ChefEquipeID;

                var members = await EmployeeEquipeService.GetEmployeesByEquipeIdAsync(selectedEquipeId.Value);
                selectedMemberIds = members.Select(emp => emp.EmployeID).ToList();

                allEmployees = employes;
            }
        }
        else
        {
            selectedEquipeName = null;
            selectedChefId = null;
            selectedMemberIds.Clear();
            allEmployees = employes;
        }
    }

    private IEnumerable<Employe> FilteredEmployees =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? allEmployees
            : allEmployees.Where(e =>
                (!string.IsNullOrEmpty(e.Nom) && e.Nom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(e.Prenom) && e.Prenom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private void OnMemberCheckboxChange(ChangeEventArgs e, int employeId)
    {
        bool isChecked = (bool)e.Value;
        if (isChecked)
        {
            if (!selectedMemberIds.Contains(employeId))
                selectedMemberIds.Add(employeId);
        }
        else
        {
            selectedMemberIds.Remove(employeId);
        }
    }

    private async Task UpdateEquipe()
    {
        if (selectedEquipeId.HasValue)
        {
            var updatedEquipe = new Equipe
            {
                EquipeID = selectedEquipeId.Value,
                NomEquipe = selectedEquipeName,
                ChefEquipeID = selectedChefId
            };

            await EquipeService.UpdateEquipeAsync(updatedEquipe);

            var existingMembers = await EmployeeEquipeService.GetEmployeesByEquipeIdAsync(selectedEquipeId.Value);
            var currentMemberIds = selectedMemberIds.ToHashSet();

            foreach (var existingMember in existingMembers)
            {
                if (!currentMemberIds.Contains(existingMember.EmployeID))
                    await EmployeeEquipeService.DeleteEmployeeEquipeAsync(existingMember.EmployeID);
            }

            foreach (var employeId in selectedMemberIds)
            {
                if (!existingMembers.Any(em => em.EmployeID == employeId))
                {
                    var newEmployeeEquipe = new EmployeeEquipe
                    {
                        EquipeeID = selectedEquipeId.Value,
                        EmployeeID = employeId,
                    };
                    await EmployeeEquipeService.AddEmployeeEquipeAsync(newEmployeeEquipe);
                }
            }

            var log = new LogActions
            {
                ActionType = ActionType.Update,
                ActionDate = DateTime.Now,
                Description = $"Modifier Équipe",
                PerformedBy = UserSession.Name,
            };

            await logsActionService.settLog(log);
            await OnUpdate.InvokeAsync();
            await OnClose.InvokeAsync();
         
        }
        await Task.Delay(1300);
        Navigation.NavigateTo("/equipe", forceLoad: true);
    }

    private void Hide_popup_UpdateEquipe()
    {
        IsVisiblUpdateEquipe = false;
        OnClose.InvokeAsync();
    }
}

