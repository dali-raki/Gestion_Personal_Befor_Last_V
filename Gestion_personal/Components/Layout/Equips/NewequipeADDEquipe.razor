@rendermode InteractiveServer
@inject UserSessionStateService UserSession

@if (IsVisibleAddEquipe)
{
    <div class="modal" tabindex="-1" style="display: block;">
        <div class="modal-dialog w-50">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajouter Équipe</h5>
                </div>
                <div class="modal-body">
                    <form class="form-container" @onsubmit="HandleSubmit">

                        <div class="form-group">
                            <label>Nom d'équipe</label>
                            <input type="text" class="form-control" placeholder="Nom d'équipe"
                                   @bind="equipeName" required />
                        </div>

                        <div class="form-group">
                            <label>Choisir Fonction</label>
                            <RadzenDropDown @bind-Value="selectedFonctionId"
                                            Data="@fonctions"
                                            TextProperty="NomFonction"
                                            ValueProperty="FonctionID"
                                            Style="width: 100%;"
                                            Placeholder="-- Choisir Fonction --"
                                            AllowClear="true"
                                            AllowFiltering="true"
                                            Change="OnFonctionChange" />
                        </div>

                        <div class="form-group">
                            <label>Choisir Chef d'équipe</label>
                            <RadzenDropDown Data="@filteredEmployes"
                                            ValueProperty="EmployeID"
                                            @bind-Value="selectedChefId"
                                            Placeholder="-- Choisir Chef d'équipe --"
                                            Style="width: 100%;"
                                            Class="form-control"
                                            Filterable="true"
                                            AllowClear="true"
                                            Disabled="@(filteredEmployes == null || !filteredEmployes.Any())">
                                <Template Context="emp">
                                    @($"{emp.Nom} {emp.Prenom}")
                                </Template>
                            </RadzenDropDown>
                        </div>

                        <div class="form-group">
                            <label>Choisir les membres de l'équipe</label>
                            <input type="text" class="form-control mb-2" placeholder="Nom ou prénom"
                                   @bind="searchTerm" @bind:event="oninput" />
                        </div>

                        <div class="form-group">

                            <div class="checkbox-group scrollable border rounded p-2" style="height: 120px;">
                                @if (FilteredEmployes.Any())
                                {
                                    @foreach (var employe in FilteredEmployes)
                                    {
                                        <label class="checkbox-item d-block">
                                            <input type="checkbox" @bind="employeeSelection[employe.EmployeID]" />
                                            @employe.Nom @employe.Prenom
                                        </label>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Aucun employé disponible</p>
                                }
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-c" @onclick="Hide_Popup_AddEquipe">Annuler</button>
                            <button type="submit" class="btn-p">Ajouter Équipe</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
