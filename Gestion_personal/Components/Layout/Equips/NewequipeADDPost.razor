@using GestionPersonnel.Services
@using global::Services.Interfaces

@inject IPosteService PosteService
@inject IEquipeService EquipeService
@inject IEmployeService EmployeService
@rendermode InteractiveServer
@inject UserSessionStateService UserSession
@if (IsVisibleAddPost)
{
    <div class="modal" tabindex="-1" style="display: block;">
        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">Ajouter Post</h5>
                </div>
                <div class="modal-body">
                    <form @onsubmit="HandleSubmit">
                        <div class="form-group">
                            <label>Date De Fin De Poste</label>
                            <input type="date" class="form-control" @bind="DateFin" required />
                        </div>
                        <div class="form-group">
                            <label>ID Post</label>
                            <input type="text" class="form-control" @bind="numeroPoste" required />
                        </div>
                              <div class="form-group">
                            <label>Choisir L'Équipe</label>
                        <RadzenDropDown @bind-Value="SelectedEquipeId"
                                        Data="@equipes"
                                        TextProperty="NomEquipe"
                                        ValueProperty="EquipeID"
                                        Style="width: 100%;"
                                        Placeholder="-- Choisir L'Équipe --"
                                        AllowClear="true"
                                        AllowFiltering="true"
                                        Change="OnEquipeChanged" />
                        </div>
                        <div class="form-group">
                            <label>Choisir les membres qui finissent le poste</label>

                            <input type="text" class="form-control mb-2 mt-1" placeholder="Rechercher par nom ou prénom"
                                   @bind="searchTerm" @bind:event="oninput" />

                            <div class="checkbox-group scrollable mt-2">
                                @if (employees != null)
                                {
                                    @foreach (var employe in FilteredEmployees)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="emp_@employe.EmployeID"
                                                   @onclick="() => ToggleEmployeeSelection(employe.EmployeID)" />
                                            <label class="form-check-label" for="emp_@employe.EmployeID">
                                                @employe.Nom @employe.Prenom
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>Chargement des employés...</p>
                                }
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-c" @onclick="Hide_Popup_AddPost">Annuler</button>
                            <button type="submit" class="btn-p">Ajouter Poste</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <style>
        .scrollable {
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 5px;
        }

    </style>
}