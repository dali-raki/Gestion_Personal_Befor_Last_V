@page "/telecharger"
@rendermode InteractiveServer
<div class="panel-employe">
    <div class="title">
        <h1>Télecharger</h1>
    </div>
    <div class="container">
        <div class="text-center">

            <button class="btn btn-primary" @onclick="ShowFileInput">
                <img src="Images/upload.png" width="30" height="30"/>sélectionner le fichier
            </button>


            @if (showFileInput)
            {
            <EditForm EditContext="editContext" OnValidSubmit="UploadRecord" FormName="FileUploadForm" class="mt-3">
                <InputFile OnChange="OnInputFileChange" accept=".data,.datafile" class="form-control"/>
                <button type="submit" class="btn btn-success">Telecharger Poitage</button>
            </EditForm>
            }
        </div>
    </div>
</div>


<ToastValidation Type="toastType" Title="@toastTitle" Message="@toastMessage" IsVisible="isToastVisible"
                 OnClose="CloseToast"/>
<style>

    .container {
        text-align: center;
    }


    .form-control {
        margin: 0 auto;
        width: 80%;
        max-width: 250px;
    }


</style>