@page "/equipe"

@rendermode InteractiveServer
@using GestionPersonnel.Models.Equipe
@inject IEquipeService EquipeService
@inject UserSessionStateService UserSession 
@if (UserSession.Role == "Admin" || UserSession.Role == "Manager")
{
<div class="panel-employe">

        <div style="display: flex;justify-content: space-between;align-items: center;">
            <div style="display:flex;align-items: baseline;">
                <div style="display: flex;align-items: center;justify-content: center;background-color: #2563eb ;padding:10px;border-radius: 7px;color:white;">
                    <span class="fa-solid fa-users" style="font-size:22px" aria-hidden="true"></span>
                </div>
                <div class="title">
                    <h1>Equipe</h1>
                </div>
            </div>
            <div>
                <div class="option-employe">


                    <div class="btn-employe">
                        <button class="btn-p" @onclick="Show_Popupd_UpdateEquipe"><i class="fa-solid fa-rotate pr-2"></i>Mise à Jour Equipe</button>
                        <button class="btn-p" @onclick="Show_Popupd_AddEquipe"> <i class="fa-solid fa-people-group pr-2"></i> Ajouter Équipe</button>
                        <button class="btn-p" @onclick="Show_Popupd_AddPost"><i class="fa-solid fa-pen-to-square pr-2"></i> Ajouter Post</button>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="input-group w-25">
                <input type="text" class="form-control" placeholder="Search" @bind="searchTerm" @oninput="SearchTeams" />
                <input type="date" class="form-control" @bind="selectedDate" />

                <button class="btn-p" type="button" @onclick="updatetab">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>





    <div class="tab-employe">
            <RadzenDataGrid TItem="EquipesInfos"
                            Data="@filteredEquipesinfo"
                            AllowPaging="true"
                            PageSize="10"
                            ShowPagingSummary="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            class="w-100">

                <Columns>
                    <RadzenDataGridColumn TItem="EquipesInfos" Property="NomEquipe" Title="Nom Equipe" Filterable=false />
                    <RadzenDataGridColumn TItem="EquipesInfos" Property="ChefEquipeNom" Title="Chef Equipe" Filterable=false />
                    <RadzenDataGridColumn TItem="EquipesInfos" Property="NombreTotalDesPostes" Title="Number Post" Filterable=false />

                    <RadzenDataGridColumn TItem="EquipesInfos" Title="Option" Filterable=false Width="100px">
                        <Template Context="equipe">
                    <div style="display: flex;align-items: center;justify-content: space-evenly;">
                            <button class="btn-d px-3 py-2"
                                    @onclick="() => DownloadPDF(equipe.EquipeID)">
                                <i class="fa-solid fa-file-pdf"></i>
                            </button>
                           </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
    </div>
</div>

    <NewequipeADDEquipe IsVisibleAddEquipe="@isVisibleAddEquipe" OnClose="Hide_Popupd_AddEquipe" OnAddEquipe="hindelUpdate" />
<NewequipeUPDEquipe IsVisiblUpdateEquipe="@isVisibleUpdateEquipe" OnClose="Hide_Popupd_UpdateEquipe" OnUpdate="hindelUpdate"></NewequipeUPDEquipe>
<NewequipeADDPost isVisibleAddPost="@isVisibleAddPost" OnClose="Hide_Popupd_AddPost" OnSave="addpost"></NewequipeADDPost>
 <SuccessPopup IsVisible="@isSuccessPopupVisible" OnClose="@HideSuccessPopup" data="@datapop" />
<script>
    function downloadFile(filename, contentType, base64Data) {
        const link = document.createElement('a');
        link.download = filename;
        link.href = `data:${contentType};base64,${base64Data}`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
}

<style>

    .modal-content {
        width: 600px;
    }
</style>
