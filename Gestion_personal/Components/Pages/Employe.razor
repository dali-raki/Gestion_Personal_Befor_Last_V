@page "/employe"
@using GestionPersonnel.Models.Fonctions
@using GestionPersonnel.Services
@using global::Services.Interfaces
@inject IEmployeService EmployeService
@inject IFonctionService FonctionService
@rendermode InteractiveServer
@inject UserSessionStateService UserSession 
@if (UserSession.Role == "Admin" || UserSession.Role == "Manager")
{
<div class="btn-refresh">
 
</div>
<div class="panel-employe">

        <div style="display: flex;justify-content: space-between;align-items: center;">
            <div style="display:flex;align-items: baseline;">
                <div style="display: flex;align-items: center;justify-content: center;background-color: #2563eb ;padding:10px;border-radius: 7px;color:white;">
                    <span class="fa-solid fa-user" style="font-size:22px" aria-hidden="true"></span>
                </div>
                <div class="title">
                    <h1>Employe</h1>
                </div>
            </div>
            <div>
                <div class="option-employe">
                 

                    <div class="btn-employe">
                        <button class="btn-p" @onclick="Show_Popup_UpdateFunction"><i class="fa-solid fa-rotate pr-2"></i>Modifier Fonction</button>
                        <button class="btn-p" @onclick="Show_Popup_AddFunction"><i class="fa-solid fa-plus pr-2"></i>Ajouter Fonction</button>
                    </div>
                </div>
            </div>
    </div>

   <div>
            <div class="input-group w-25">
                <input type="text" class="form-control" placeholder="Search" @bind-value="searchTerm" @oninput="SearchEmployees" />
                <button class="btn-p" type="button">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
   </div>
    


       
    <div class="tab-employe">
        <RadzenDataGrid TItem="GestionPersonnel.Models.Employe.Employe" Data="@filteredEmployees"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10">
            <Columns>    
                        <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="Nom" Title="Nom" Filterable=false />
                        <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="Prenom" Title="Prenom" Filterable=false />
                        <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="FonctionName" Title="Fonction" Filterable=false />
                        <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="NSecuriteSocial" Title="N Securite Sociale" Filterable=false />
                        <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Title="Option" Width="130px" Filterable=false>
                    <Template Context="employee" >
                            <div style="display: flex;align-items: center;justify-content: space-evenly;">
                                <button class="btn-p px-3 py-2" @onclick="() => Show_Popup_UpdateEmploye(employee)">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button class="btn-d px-3 py-2" @onclick="() => ConfirmDelete(employee.EmployeID)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                         </div>
                     
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="text-center">No employees found.</div>
            </EmptyTemplate>
            <LoadingTemplate>
                <div class="text-center">Loading...</div>
            </LoadingTemplate>
        </RadzenDataGrid>
    </div>
    <AddFonctionPopup IsVisibleAddFunction="@isVisibleAddFunction" OnClose="@Hide_Popup_AddFunction" OnSave="@HandleFonctionSave" />
        <ModifierFonctionPopup IsVisibleUpdateFunction="@isVisibleUpdFunction" OnClose="@Hide_Popup_UpdateFunction" OnSave="@HandleModifyFonctionSave" OnDelete="HandleDeleteFonction" />
    <SuccessPopup IsVisible="@isSuccessPopupVisible" OnClose="@HideSuccessPopup" data="@datapop"/>
    <UpdateEmployeePopup IsVisibleUpdateEmploye="@isEditPopupVisible" Employee="@selectedEmployee" OnClose="@Hide_Popup_UpdateEmploye" OnSave="@HandleEditSave" />
    <ConfirmationPopup IsVisibleConfirm="isConfirmVisible" OnClose="HandlePopupResponse" Title="Confirmation" OnDelete="HandelConfirmation"/>
</div>

<style>
    .option-employe {
        display: flex;
        align-items: center;
        justify-content: space-between; 
        gap: 10px; 
    }

    .btn-refresh {
        margin-right: auto; 
    }

        .rz-button.rz-primary{
            background-color: #2563eb;
        }
</style>
}