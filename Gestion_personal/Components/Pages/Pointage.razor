@page "/pointage"
@using ModelsPointage = GestionPersonnel.Models.Pointage
@using GestionPersonnel.Services
@inject IPointageService PointageService
@rendermode InteractiveServer
@inject UserSessionStateService UserSession 
@if (UserSession.Role == "Admin" || UserSession.Role == "Manager")
{

<div class="panel-employe">

        <div style="display: flex;justify-content: space-between;align-items: center;">
            <div style="display:flex;align-items: baseline;">
                <div style="display: flex;align-items: center;justify-content: center;background-color: #2563eb ;padding:10px;border-radius: 7px;color:white;">
                    <span class="fa-solid fa-clipboard-list" style="font-size:22px" aria-hidden="true"></span>
                </div>
                <div class="title">
                    <h1>Poinateg</h1>
                </div>
            </div>
            <div>
                <div class="option-employe">


                    <div class="btn-employe">
                        <button class="btn-p" @onclick="ShowFileInput"><i class="fa-solid fa-file pr-2"></i> Sélectionner le fichier</button>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="input-group w-25">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Search" @bind-value="searchTerm" @oninput="Searchpointage" />
                    <input type="date" class="form-control" @bind="selectedDate" />
                    <button class="btn-p" @onclick="GetPointageByDate"> <i class="fa-solid fa-magnifying-glass"></i></button>
             
                </div>
            </div>
        </div>



    @using Radzen

    <div class="tab-employe">
        <RadzenDataGrid @ref="grid" TItem="ModelsPointage.Pointage" Data="@filteredPointages"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10">
            <Columns>
                <!-- Full Name -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Nom Complet" Filterable=false>
                    <Template Context="pointage">
                        @($"{pointage.NomEmploye} {pointage.PrenomEmploye}")
                    </Template>
                </RadzenDataGridColumn>
                <!-- Function Name -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="NomFonction" Title="Fonction" Filterable=false />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Entrée / Sortie" Width="200px" Filterable=false>
                    <Template Context="pointage">
                        <span title="Heure d'entrée">
                            <i class="fa-solid fa-sign-in-alt" style="color: green;"></i>
                            <span style="color: green; margin-right: 10px;">
                                @pointage.HeureEntree
                            </span>
                        </span>
                        <span title="Heure de sortie">
                            <i class="fa-solid fa-sign-out-alt" style="color: red;"></i>
                            <span style="color: red;">
                                @pointage.HeureSortie
                            </span>
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <!-- Day -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="HeuresTravaillees" Title="Heures Travaillees" Width="200px" Filterable=false />
                <!-- Day -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="journee" Title="Journée" Width="120px" Filterable=false />
                <!-- Remarks -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="Remarque" Title="Remarque" Filterable=false />
                <!-- Option (Edit Button) -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Option" Width="100px" Filterable=false>
                    <Template Context="pointage">
                        <div style="display:flex;justify-content:center;">
                            <button class="btn-p px-3 py-2" @onclick="() => Show_Popup_UpdatePointage(pointage)">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>

                        </div>
                       
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="text-center">No found Pointage</div>
            </EmptyTemplate>
        </RadzenDataGrid>
    </div>
</div>

<NewPointagePopUp IsVisiblePointage="@isVisiblePointage"
                  OnClose="Hide_Popup_UpdatePointage"
                  Onsubmit="hendelSubmit"
                  Pointage="selectedPointage" />

    <SuccessPopup IsVisible="@isSuccessPopupVisible" OnClose="@HideSuccessPopup" data="@datapop" />


@if (showFileInput)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Télécharger Pointage</h5>
                      </div>

                <div class="modal-body">
                    <EditForm EditContext="editContext" OnValidSubmit="UploadRecord" FormName="FileUploadForm">
                        <InputFile OnChange="OnInputFileChange" accept=".data,.datafile" class="form-control" />
                        <div class="modal-footer">
                            <button type="button" class="btn-c" @onclick="CloseModal">Annuler</button>
                            <button type="submit" class="btn-p" form="FileUploadForm" @onclick="UploadRecord">Télécharger</button>                          
                        </div>

                    </EditForm>
                </div>

             
            </div>
        </div>
    </div>
}
}