@page "/pointage"
@using ModelsPointage = GestionPersonnel.Models.Pointage
@using GestionPersonnel.Services
@inject IPointageService PointageService
@rendermode InteractiveServer


<div class="panel-employe">
    <div class="title">
        <h1>Pointage</h1>
    </div>
    <div class="option-employe">

        <div class="input-group w-25">
            <input type="text" class="form-control" placeholder="Search" @bind-value="searchTerm" @oninput="Searchpointage" />
            <button class="btn-p" type="button">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>


        <div class="btn-employe">
            <input type="date" class="form-control" @bind="selectedDate" />
            <button class="btn-p" @onclick="GetPointageByDate">Get</button>
        </div>
    </div>


    @using Radzen

    <div class="tab-employe">
        <RadzenDataGrid @ref="grid" TItem="ModelsPointage.Pointage" Data="@filteredPointages"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10">
            <Columns>
                <!-- Full Name -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Nom Complet">
                    <Template Context="pointage">
                        @($"{pointage.NomEmploye} {pointage.PrenomEmploye}")
                    </Template>
                </RadzenDataGridColumn>
                <!-- Function Name -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="NomFonction" Title="Fonction" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Entrée / Sortie" Width="180px">
                    <Template Context="pointage">
                        <span title="Heure d'entrée">
                            <i class="fa-solid fa-sign-in-alt" style="color: green;"></i>
                            <span style="color: green; margin-right: 10px;">
                                @pointage.HeureEntree
                            </span>
                        </span>
                        <span title="Heure de sortie">
                            <i class="fa-solid fa-sign-out-alt" style="color: red;"></i>
                            <span style="color: red;">
                                @pointage.HeureSortie
                            </span>
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <!-- Day -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="HeuresTravaillees" Title="Heures Travaillees" Width="200px" />
                <!-- Day -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="journee" Title="Journée" Width="120px" />
                <!-- Remarks -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="Remarque" Title="Remarque" />
                <!-- Option (Edit Button) -->
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Option" Width="100px">
                    <Template Context="pointage">
                        <div style="display:flex;justify-content:center;">
                            <button class="btn-p px-3 py-2" @onclick="() => Show_Popup_UpdatePointage(pointage)">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>

                        </div>
                       
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="text-center">No found Pointage</div>
            </EmptyTemplate>
        </RadzenDataGrid>
    </div>
</div>

<NewPointagePopUp IsVisiblePointage="@isVisiblePointage"
                  OnClose="Hide_Popup_UpdatePointage"
                  Pointage="selectedPointage" />