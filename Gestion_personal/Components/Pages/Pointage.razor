@page "/pointage"
@using ModelsPointage = GestionPersonnel.Models.Pointage
@using GestionPersonnel.Services
@inject IPointageService PointageService
@rendermode InteractiveServer


<div class="panel-employe">
    <div class="title">
        <h1>Pointage</h1>
    </div>
    <div class="option-employe">

        <div class="input-group w-25">
            <input type="text" class="form-control" placeholder="Search" @bind-value="searchTerm" @oninput="Searchpointage" />
            <button class="btn-p" type="button">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>


        <div class="btn-employe">
            <input type="date" class="form-control" @bind="selectedDate" />
            <button class="btn-p" @onclick="GetPointageByDate">Get</button>
        </div>
    </div>


    @using Radzen

    <div class="tab-employe">
        <RadzenDataGrid @ref=grid TItem="ModelsPointage.Pointage" Data="@filteredPointages"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Nom Prenom">
                    <Template Context="pointage">
                        @pointage.NomEmploye @pointage.PrenomEmploye
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="NomFonction" Title="Fonction" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="Stat" Title="Status" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="HeuresTravaillees" Title="Heur" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="JourneeCoefficient" Title="Pourcentage" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="HeuresSupplementairesCoefficient" Title="Supplementaires" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="journee" Title="journee" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Property="Remarque" Title="Remarque" />
                <RadzenDataGridColumn TItem="ModelsPointage.Pointage" Title="Option">
                    <Template Context="pointage">
                        <button class="btn-p px-3 py-2" @onclick="() => Show_Popup_UpdatePointage(pointage)">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="text-center">No found Pointage</div>
            </EmptyTemplate>
        </RadzenDataGrid>
    </div>
</div>

<NewPointagePopUp IsVisiblePointage="@isVisiblePointage"
                  OnClose="Hide_Popup_UpdatePointage"
                  Pointage="selectedPointage" />