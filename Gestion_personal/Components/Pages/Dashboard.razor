@page "/Dashboard"
@rendermode InteractiveServer
@using Infrastructures.Domains.Models.Dashboard
@using Infrastructures.Domains.Models.Logs
@if (UserSession.Role == "Admin" || UserSession.Role == "Manager")
{
<div class="panel-employe">


        <div style="display: flex;justify-content: space-between;align-items: center;">
            <div style="display:flex;align-items: baseline;">
                <div style="display: flex;align-items: center;justify-content: center;background-color: #2563eb ;padding:10px;border-radius: 7px;color:white;">
                    <span class="fa-solid fa-house" style="font-size:22px" aria-hidden="true"></span>
                </div>
                <div class="title">
                    <h1>Dashborad</h1>
                </div>
            </div>
          
        </div>

        <div class="cards">
            <CardInfo Number="@Total_Number_Employe" Title="N° d'employés" Icon="fa-solid fa-user" Show="false" />
            <CardInfo Number="@countEquipe" Title="N° D'equipes" Icon="fa-solid fa-users" Show="false" />
            <CardInfo Number="@(absenceComparison?.PointageThisMonth ?? 0)" Title="N° d'absences" Icon="fa-solid fa-user-minus" Show="true" Difference="@absencePercentage" />
            <CardInfo Number="@(presenceComparison?.PointageThisMonth ?? 0)" Title="N° de présences" Icon="fa-solid fa-user-check" Show="true" Difference="@presencePercentage" />
        </div>
    <div class="dashboard-content">
       
        <div class="graph">
                <div class="graph1" style="width:100%">
                    <RadzenCard Style="height:100%; ">
                    <h3 style="text-align:center;">Dette et avance par mois - @SelectedYear</h3>
                    <div>
                        <RadzenChart Style="height:250px; ">
                            <RadzenCategoryAxis />
                            <RadzenValueAxis>
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenColumnSeries Data="@DashboardChartData" CategoryProperty="Label" ValueProperty="Dette" Title="Dette" />
                            <RadzenColumnSeries Data="@DashboardChartData" CategoryProperty="Label" ValueProperty="Avance" Title="Avance" />
                        </RadzenChart>
                    </div>
                </RadzenCard>
            </div>
                <div class="graph2" style="width:70%">
                <RadzenCard>
                    <h3 style="text-align:center;">Employes par fonction</h3>
                    <div>
                      
                            <RadzenStack Gap="0.5rem" Wrap="FlexWrap.Wrap" >
                            <div style="display:flex;gap:10px;flex-direction: row-reverse;padding:15px;font-size:1.2rem;">
                                    <div>
                                    <RadzenCheckBox @bind-Value="@showDataLabels" Name="dataLabels"></RadzenCheckBox>
                                    </div>
                                    <div>
                                    <RadzenLabel Text="Show Data Labels" Component="dataLabels" />
                                    </div>
                                </div>
                            </RadzenStack>
                      
                        <RadzenChart>
                            <RadzenPieSeries Data="@countfunction" CategoryProperty="Name" ValueProperty="Total" Title="Employees by Function" >
                                <RadzenSeriesDataLabels Visible="@showDataLabels" />
                            </RadzenPieSeries>
                        </RadzenChart>
                    </div>
                </RadzenCard>
            </div>
        </div>
    </div>
  <RadzenCard Style="margin-bottom:2rem;">
    <RadzenTabs RenderMode="TabRenderMode.Client" @bind-SelectedIndex=@selectedIndex>
        <Tabs>
                    <RadzenTabsItem Text="Suivi De Présence">
                        <div class="pointage-tab">
                            <div class="option-employe mb-5">
                                <div class="searchZone w-25">

                                    <div class="input-group ">
                                        <input type="text" class="form-control" placeholder="Search" @bind="searchTerm" @bind:event="oninput" />
                                        <input type="date" class="form-control" @bind="selectedDate" />
                                        <button class="btn-p" type="button" @onclick="() => GetPointageByDate(selectedDate.Year, selectedDate.Month)">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                            <RadzenDataGrid @ref="grid" Data="@FilteredPointage" TItem="DashboardPointage"
                                            ShowPagingSummary="true" PageSize="10" AllowPaging="true" AllowSorting="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="DashboardPointage" Property="EmployeID" Title="Id" Width="50px" Filterable=false />
                                    <RadzenDataGridColumn TItem="DashboardPointage" Property="NomComplet" Title="Full Name" Width="200px" Filterable=false />
                                    <RadzenDataGridColumn TItem="DashboardPointage" Property="NombrePresences" Title="Presences" Width="110px" Filterable=false />
                                    <RadzenDataGridColumn TItem="DashboardPointage" Property="NombreAbsences" Title="Absences" Width="110px" Filterable=false />
                                    <RadzenDataGridColumn TItem="DashboardPointage" Property="NombreHeuresSupp" Title="Overtime" Width="100px" Filterable=false />
                                </Columns>
                            </RadzenDataGrid>

                        </div>
                    </RadzenTabsItem>
                <RadzenTabsItem Text="Employes Sortants">
                <!--Tab1start-->
                    <div class="option-employe">
                        <div class="input-group w-25">
                            <input type="text" class="form-control" placeholder="Search" @bind-value="searchTerm2" @oninput="SearchEmployees" />
                            <button class="btn-p" type="button">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </div>
                    </div>
                    <div class="tab-employe">
                        <RadzenDataGrid TItem="GestionPersonnel.Models.Employe.Employe" Data="@filteredEmployees"
                                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10">
                            <Columns>
                                    <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Title="Nom" Filterable=false>
                                        <Template Context="employee">
                                            <span style="text-transform: uppercase; font-weight: bold;">
                                                @employee.Nom
                                            </span>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="Prenom" Title="Prenom" Filterable=false />
                                    <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="FonctionName" Title="Fonction"  Filterable=false/>
                                    <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Property="NSecuriteSocial" Title="N Securite Sociale" Filterable=false />
                                    <RadzenDataGridColumn TItem="GestionPersonnel.Models.Employe.Employe" Title="Option" Width="130px" Filterable=false>
                                    <Template Context="employee">
                                            <div style="display: flex;align-items: center;justify-content: space-evenly;">

                                      
                                        <button class="btn-p px-3 py-2" @onclick="() => Show_Popup_UpdateEmploye(employee)">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button class="btn-d px-3 py-2" @onclick="() => ConfirmReturn(employee.EmployeID)">
                                            <i class="fa-solid fa-rotate-left"></i>
                                        </button>

                                            </div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                            <EmptyTemplate>
                                <div class="text-center">No employees found.</div>
                            </EmptyTemplate>
                            <LoadingTemplate>
                                <div class="text-center">Loading...</div>
                            </LoadingTemplate>
                        </RadzenDataGrid>
                    </div>
                    <UpdateEmployeePopup IsVisibleUpdateEmploye="@isEditPopupVisible" Employee="@selectedEmployee" showbtn=false IsDisabled=true OnClose="@Hide_Popup_UpdateEmploye" />
                        <ConfirmationPopup IsVisibleConfirm="isConfirmVisible" OnClose="HandlePopupResponse" OnDelete="handelemplye" Title="Confirmation" objective="Renvoyer" />
                    <!--Tab1end-->
            </RadzenTabsItem>
                   
                @if (UserSession.Role == "Admin")
                {

                        <RadzenTabsItem Text="Trace Des opérations">
                        <div class="option-employe mb-5">
                            <div class="input-group w-25">
                                    <input type="text" class="form-control" placeholder="Search" @bind-value="searchTerm" @bind-value:event="oninput" />
                                <button class="btn-p" type="button">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>
                        </div>
                        <RadzenDataGrid @ref="grid2" Data="@FilteredLogs" TItem="LogActions"
                                        ShowPagingSummary="true" PageSize="10"
                                        AllowPaging="true" AllowSorting="true">
                            <Columns>
                                    <RadzenDataGridColumn TItem="LogActions" Property="ActionType" Title="Action" Width="120px" Filterable=false />
                                    <RadzenDataGridColumn TItem="LogActions" Property="PerformedBy" Title="User" Width="150px" Filterable=false />
                                    <RadzenDataGridColumn TItem="LogActions" Property="Description" Title="Description" Filterable=false />
                                <RadzenDataGridColumn TItem="LogActions" Property="ActionDate" Title="Date"
                                                          Width="180px" Filterable=false>
                                    <Template Context="log">
                                        @log.ActionDate.ToString("yyyy-MM-dd HH:mm")
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>
                }
        </Tabs>
    </RadzenTabs>
 </RadzenCard>
    </div>
    <SuccessPopup IsVisible="@isSuccessPopupVisible" OnClose="@HideSuccessPopup" data="@datapop" />

}
@code {

    public class TotalItem
    {
        public string Label { get; set; }
        public decimal Value { get; set; }
    }
    private bool showDataLabels { get; set; } = true;
    List<TotalItem> totals => new()
    {
        new TotalItem { Label = "Dette", Value = Total_Dette },
        new TotalItem { Label = "Avance", Value = Total_Avance }
    };
    private void Hide_Popup_UpdateEmploye() => isEditPopupVisible = false;

}

<style>
 
    #search {
        width: 100%;
    }

    .search-controls {
        display: flex;
        padding: 10px;
        justify-content: flex-end;
        align-items: baseline;
        gap: 10px;
        margin: 10px 0px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        font-family: Arial, sans-serif;
    }

        .form-group label {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 4px;
            color: #333;
        }

    .search-input {
        padding: 8px 10px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 4px;
        outline: none;
        transition: border-color 0.2s ease;
    }

        .search-input:focus {
            border-color: #007bff;
        }

    </style>