@page "/paiement"
@using GestionPersonnel.Models.Salaires
@using GestionPersonnel.Services
@inject ISalaireService SalaireService
@inject IPDFService PDFService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@inject UserSessionStateService UserSession 
@if (UserSession.Role == "Admin" || UserSession.Role == "Manager")
{
    <div class="panel-employe">
  @*   <div style="display:flex;align-items: flex-start;">
        <button class="btn-p" @onclick="TransferPointageSalaire">
            <i class="fa-solid fa-rotate"></i>
        </button>
    <div class="title">
        <h1>Paiement</h1>
    </div>
    </div>
    <div class="option-employe">
        <div class="input-group w-50">

            <input type="text" class="form-control" placeholder="Search" @bind="searchTerm" @oninput="SearchPaiement">
            <input type="date" class="form-control" @bind="selectedDate" />
                <button class="btn-p" type="button" @onclick="GetSalariesByMonth">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
        
        </div>
        <button class="btn-p" @onclick="Show_Popup_FicheAvance">Fiche des Avances</button>
    </div> *@


        <div style="display: flex;justify-content: space-between;align-items: center;">
            <div style="display:flex;align-items: baseline;">
                <div style="display: flex;align-items: center;justify-content: center;background-color: #2563eb ;padding:10px;border-radius: 7px;color:white;">
                    <span class="fa-solid fa-money-check-dollar" style="font-size:22px" aria-hidden="true"></span>
                </div>
                <div class="title">
                    <h1>Paiement</h1>
                </div>
            </div>
            <div>
                <div class="option-employe">


                    <div class="btn-employe">
                        <button class="btn-p" @onclick="Show_Popup_FicheAvance"><i class="fa-solid fa-money-check-dollar pr-2"></i> Fiche des Avances</button>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="input-group w-25">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Search" @bind="searchTerm" @oninput="SearchPaiement">
                    <input type="date" class="form-control" @bind="selectedDate" />
                    <button class="btn-p" type="button" @onclick="GetSalariesByMonth">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                </div>
            </div>
        </div>





    <div class="tab-employe">
        <RadzenDataGrid @ref="grid" TItem="SalaireDetail" Data="@filteredSalaries"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10" @bind-PageIndex="currentPage">
            <Columns>

                <!-- Employé -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Employé" Filterable=false>
                    <Template Context="s">
                        <div class="d-flex align-items-center">
                            <div class="fw-bold">@s.NomEmploye @s.PrenomEmploye</div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Fonction -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Property="NomFonction" Title="Fonction" Filterable=false />

                <!-- Salaire -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Salaire" Filterable=false>
                    <Template Context="s">
                        <span class="fw-bold">@s.Salaire.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Avance -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Avance" Filterable=false Width="120px">
                    <Template Context="s">
                            <span class="fw-bold"  style="color:darkorange;">@s.Avances.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Dette -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Dette" Filterable=false Width="120px">
                    <Template Context="s">
                        <span class="text-danger fw-bold">@s.Dettes.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Prime -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Prime" Filterable=false Width="120px">
                    <Template Context="s">
                            <span class="text-success fw-bold">@s.Primes.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Rembourcement -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Remboursements" Filterable=false Width="190px">
                    <Template Context="s">
                        <span class="text-success fw-bold">@s.Refund.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Net à payer -->
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Net à payer" Filterable=false>
                    <Template Context="s">
                            <span class="fw-bold" style="color:black;"> @s.SalaireNet.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SalaireDetail" Title="présence" Width="130px" Filterable=false>
                    <Template Context="s">
                        <div style="display: flex;justify-content: space-evenly;align-items: baseline;">
                            <span class="text-success fw-bold" style="background-color: #c8ffdf;padding: 3px 8px;width:35px; border-radius: 5px;text-align:center;">@s.Presence.ToString("N0")</span>
                                <span class="text-danger fw-bold" style="background-color: #ffc8c8;padding: 3px 8px;width:35px; border-radius: 5px;text-align:center;">@s.Absence.ToString("N0")</span>

                        </div>
                    </Template>
                </RadzenDataGridColumn>

         
                    <RadzenDataGridColumn TItem="SalaireDetail" Title="Actions" Filterable=false >
                    <Template Context="s">
                            <div style="display: flex;align-items: center;justify-content: space-evenly;">
                                <button class="btn-d px-3 py-2"
                                    @onclick="() => GeneratePDF(s, DateOnly.FromDateTime(selectedDate.Value))">
                                    <i class="fa-solid fa-file-pdf"></i>
                            </button>
                                <button class="btn-p px-3 py-2" @onclick="() => paimentAvanceDettePopUp.Show(s)" disabled="@(!statusTransaction)">
                                    <i class="fa-solid fa-money-bill-transfer"></i> 
                            </button>
                                <button class="btn-p px-3 py-2" @onclick="() => Show_Popup_FicheAvanceDette(s.EmployeId)">
                                    <i class="fa-solid fa-magnifying-glass-dollar"></i>
                                </button>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>

            <EmptyTemplate>
                <div class="text-center">No found Paiement</div>
            </EmptyTemplate>
        </RadzenDataGrid>

    </div>
</div>
<PaimentAvanceDettePopUp @ref="paimentAvanceDettePopUp" OnSaved="RefreshGrid" />
<FiceAvance IsVisibleFicheAvance="@isVisibleFicheAvance" OnClose="@Hide_Popup_FicheAvance" />
    <DetteAvanceEmployeFrom IsVisibleFicheAvanceDette="@isVisibleFicheAvanceDette" OnClose="@Hide_Popup_FicheAvanceDette" EmployeID="@SelectedEmployeID" Date="selectedDate.Value" />
    <SuccessPopup IsVisible="@isSuccessPopupVisible" OnClose="@HideSuccessPopup" data="@datapop" />

}
<style>
    .badge-circle {
        width: 30px;
        height: 30px;
        background-color: #e0e7ff;
        color: #3b82f6;
        font-weight: bold;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
 </style>