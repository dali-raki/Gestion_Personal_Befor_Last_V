@page "/paiement"
@using GestionPersonnel.Models.Salaires
@using GestionPersonnel.Services
@inject ISalaireService SalaireService
@inject IPDFService PDFService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="panel-employe">
    <div style="display:flex;align-items: flex-start;">
        <button class="btn-p" @onclick="TransferPointageSalaire">
            <i class="fa-solid fa-rotate"></i>
        </button>
    <div class="title">
        <h1>Paiement</h1>
    </div>
    </div>
    <div class="option-employe">
        <div class="input-group w-50">

            <input type="text" class="form-control" placeholder="Search" @bind="searchTerm" @oninput="SearchPaiement">
            <input type="date" class="form-control" @bind="selectedDate" />
                <button class="btn-p" type="button" @onclick="GetSalariesByMonth">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
        
        </div>
        <button class="btn-p" @onclick="Show_Popup_FicheAvance">Fiche des Avances</button>
    </div>

    <div class="tab-employe">
        <RadzenDataGrid @ref="grid" TItem="SalaireDetail" Data="@filteredSalaries"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10" @bind-PageIndex="currentPage">
            <Columns>

                <!-- Employé -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Employé">
                    <Template Context="s">
                        <div class="d-flex align-items-center">
                            <div class="fw-bold">@s.NomEmploye @s.PrenomEmploye</div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Fonction -->
                <RadzenDataGridColumn TItem="SalaireDetail" Property="NomFonction" Title="Fonction" />

                <!-- Salaire -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Salaire">
                    <Template Context="s">
                        <span class="fw-bold">@s.Salaire.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Avance -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Avance">
                    <Template Context="s">
                        <span class="text-danger">@s.Avances.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Dette -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Dette">
                    <Template Context="s">
                        <span class="text-danger">@s.Dettes.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Prime -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Prime">
                    <Template Context="s">
                        <span class="text-success">@s.Primes.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Rembourcement -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Remboursements">
                    <Template Context="s">
                        <span class="text-success fw-bold">@s.Refund.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <!-- Net à payer -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Net à payer">
                    <Template Context="s">
                        <span class="text-success fw-bold">@s.SalaireNet.ToString("N0") DA</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="SalaireDetail" Title="présence" Width="130px">
                    <Template Context="s">
                        <div style="display: flex;justify-content: space-evenly;align-items: baseline;">
                            <span class="text-success fw-bold" style="background-color: #c8ffdf;padding: 3px 8px; border-radius: 5px;">@s.Presence.ToString("N0")</span>
                        <span class="text-danger fw-bold" style="background-color: #ffc8c8;padding: 3px 8px; border-radius: 5px;">@s.Absence.ToString("N0")</span> 
                          
                        </div>
                    </Template>
                </RadzenDataGridColumn>

               @*  <!-- Statut -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Statut">
                    <Template Context="s">
                        @if (s.SalaireNet > 0)
                        {
                            <span class="badge bg-success">Payé</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">En attente</span>
                        }
                    </Template>
                </RadzenDataGridColumn> *@

                <!-- Actions -->
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Actions">
                    <Template Context="s">
                        <div class="d-flex gap-1">
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => GeneratePDF(s, DateOnly.FromDateTime(selectedDate.Value))">
                                <i class="bi bi-file-earmark-pdf"></i> PDF
                            </button>
                            <button class="btn btn-primary btn-sm" @onclick="() => paimentAvanceDettePopUp.Show(s)" disabled="@(!statusTransaction)">
                                <i class="fa fa-plus"></i> Transaction
                            </button>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>

            <EmptyTemplate>
                <div class="text-center">No found Paiement</div>
            </EmptyTemplate>
        </RadzenDataGrid>

    </div>
</div>
<PaimentAvanceDettePopUp @ref="paimentAvanceDettePopUp" OnSaved="RefreshGrid" />
<FiceAvance IsVisibleFicheAvance="@isVisibleFicheAvance" OnClose="@Hide_Popup_FicheAvance" />

<style>
    .badge-circle {
        width: 30px;
        height: 30px;
        background-color: #e0e7ff;
        color: #3b82f6;
        font-weight: bold;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
 </style>