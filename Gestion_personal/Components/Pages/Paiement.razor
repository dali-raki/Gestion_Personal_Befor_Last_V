@page "/paiement"
@using GestionPersonnel.Models.Salaires
@using GestionPersonnel.Services
@inject ISalaireService SalaireService
@inject IPDFService PDFService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="panel-employe">
    <div style="display:flex;align-items: flex-start;">
        <button class="btn-p" @onclick="TransferPointageSalaire">
            <i class="fa-solid fa-rotate"></i>
        </button>
    <div class="title">
        <h1>Paiement</h1>
    </div>
    </div>
    <div class="option-employe">
        <div class="input-group w-50">

            <input type="text" class="form-control" placeholder="Search" @bind="searchTerm" @oninput="SearchPaiement">
            <input type="date" class="form-control" @bind="selectedDate" />
                <button class="btn-p" type="button" @onclick="GetSalariesByMonth">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
        
        </div>
        <button class="btn-p" @onclick="Show_Popup_Paiement">Ajouter Employeur Paiement</button>
    </div>

    <div class="tab-employe">
        <RadzenDataGrid TItem="SalaireDetail" Data="@filteredSalaries"
                        AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Nom et Prenom">
                    <Template Context="salaire">
                        @salaire.NomEmploye @salaire.PrenomEmploye
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SalaireDetail" Property="NomFonction" Title="Fonction" />
                <RadzenDataGridColumn TItem="SalaireDetail" Property="TypePaiement" Title="Type Paiement" />
                <RadzenDataGridColumn TItem="SalaireDetail" Property="Salaire" Title="Salaire" />
                <RadzenDataGridColumn TItem="SalaireDetail" Property="Primes" Title="Primes" />
                <RadzenDataGridColumn TItem="SalaireDetail" Property="Avances" Title="Avances" />
                <RadzenDataGridColumn TItem="SalaireDetail" Property="Dettes" Title="Dettes" />
                <RadzenDataGridColumn TItem="SalaireDetail" Property="SalaireNet" Title="SalaireNet" />
                <RadzenDataGridColumn TItem="SalaireDetail" Title="Option">
                    <Template Context="salaire">
                        <button class="btn-d px-3 py-2" @onclick="() => GeneratePDF(salaire)">
                            PDF
                        </button>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <div class="text-center">No found Paiement</div>
            </EmptyTemplate>
        </RadzenDataGrid>
    </div>
</div>

<NewpaiementPopUp IsVisible="@IsPopupVisible" OnClose="@Hide_Popup_Paiement" />